{{'custom-product-grid.css' | asset_url | stylesheet_tag}}
<section class="custom-product-grid">

<h2 class="custom-product-grid__title">
{{section.settings.title}}
</h2>

<div class="custom-product-grid__items">
{% for block in section.blocks %}
{% assign product= block.settings.product %}
{%# only render a product card when a prodeuct has been selected in the theme customizer%}
{% if product != blank %}

<article
class="product-card"
data-product-id="{{ product.id }}"
{{ block.shopify_attributes }}
>

<button
class="product-card__trigger"
type="button"
 data-product-trigger
 >
 {%# product image checks if the product has an image, generate image url and asks shopify for appropriate sized image %}
 {% if product.featured_image %}
 <img
 src="{{ product.featured_image | image_url: width: 1000 }}"
 alt="{{ product.title }}"
 class="product-card__image"
 >
 {% endif %}
 <span class="product-card__plus"> + </span>
 </button>
{%- comment -%}
Expose the selected product data as JSON so the JavaScript modal can dynamically
render product information, variants, and the correct variant ID for cart actions.
{%- endcomment -%}
 <script type="application/json" class="product-data">
 {
    "id": {{ product.id | json }},
    "title": {{ product.title | json }},
    "description": {{ product.description | strip_html | json }},
    "featured_image": {{ product.featured_image | image_url: width: 1000 | json }},
    "price": {{ product.price | money | json }},
    "variants": [
        {% for variant in product.variants %}
        {
            "id": {{ variant.id | json }},
            "title": {{ variant.title | json }},
            "available": {{ variant.available | json }},
            "options": {{ variant.options | json }}
            }
            {% unless forloop.last %},
            {% endunless %}
            {% endfor %}
            ]
            }
            </script>
            </article>
            {% endif %}
            {% endfor %}
            </div>
            <div
            class="product-modal"
            data-product-modal
            aria-hidden="true"
            >
            <div class="product-modal__overlay" data-modal-close></div>
            <div class="product-modal__content">
            <button
            type="button"
            class="product-modal__close"
            data-modal-close
            >
            ×
            </button>
            <!-- Product image and basic information -->
            <div class="product-modal__product-info">
            <div class="product-modal__image-wrapper">
            <img
            src=""
            alt=""
            data-modal-image
            >
            </div>
            <div class="product-modal__details">
            <h2 data-modal-title></h2>
            <p data-modal-price></p>
            <div data-modal-description></div>
             </div>
             </div>
             <!-- Product variants are generated dynamically by JavaScript -->
             <div
             class="product-modal__options"
             data-modal-options
             ></div>
             <!-- Add selected variant to cart -->
             <button
             type="button"
             class="product-modal__add"
             data-add-to-cart
             >
             <span>ADD TO CART</span>
             <span class="product-modal__arrow">→</span>
             </button>
             <p
             class="product-modal__message"
             data-cart-message
             ></p>
            </div>
        </div>
            </section>
            <script src="{{ 'custom-product-grid.js' | asset_url }}" defer></script>


{% schema %}
{
    "name":"Product Grid",
    "settings":[
        {
            "type": "text",
            "id": "title",
            "label": "Section title",
            "default": "Tisso vison in the wild"
        }
    ],
    "blocks": [
        {
            "type": "product",
            "name": "Product",
            "limit": 6,
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Select product"
                    }
                    ]
                    }
                    ],
                    "max_blocks": 6,
                    "presets": [
                        {
                            "name": "Custom Product Grid",
                            "blocks": [
                                {
                                    "type": "product"
                                },
                                {
                                    "type": "product"
                                },
                                {
                                    "type": "product"
                                },
                                {
                                    "type": "product"
                                },
                                {
                                    "type": "product"
                                },
                                {
                                    "type": "product"
                                },
                                ]
                                }
            ]
        }
{% endschema %}
