{{ 'custom-product-grid.css' | asset_url | stylesheet_tag }}

<section class="custom-product-grid">

  <h2 class="custom-product-grid__title">
    {{ section.settings.title }}
  </h2>

  <div class="custom-product-grid__items">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      
      {% comment %} Only render a product card when a product has been selected in the theme customizer {% endcomment %}
      {% if product != blank %}

        <article
          class="product-card"
          data-product-id="{{ product.id }}"
          {{ block.shopify_attributes }}
        >

          <button
            class="product-card__trigger"
            type="button"
            data-product-trigger
          >
            {% comment %} Product image checks if the product has an image, generate image url {% endcomment %}
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 1000 }}"
                alt="{{ product.title | escape }}"
                class="product-card__image"
              >
            {% endif %}
            <span class="product-card__plus"> + </span>
          </button>

          {% comment %}
            Serialize full product object so JavaScript can accurately parse option names, 
            variant IDs, prices, and options array without missing data.
          {% endcomment %}
          <script type="application/json" class="product-data">
            {{ product | json }}
          </script>

        </article>
      {% endif %}
    {% endfor %}
  </div>

  <div
    class="product-modal"
    data-product-modal
    aria-hidden="true"
  >
    <div class="product-modal__overlay" data-modal-close></div>
    
    <div class="product-modal__content">
      <button
        type="button"
        class="product-modal__close"
        data-modal-close
      >×
      </button>

      <div class="product-modal__image-wrapper">
        <img
          src=""
          alt=""
          data-modal-image
        >
      </div>

      <div class="product-modal__details">
        <h2 data-modal-title></h2>
        <p data-modal-price></p>
        <div data-modal-description></div>

        <div
          class="product-modal__options"
          data-modal-options
        >
        </div>

        <button
          type="button"
          class="product-modal__add"
          data-add-to-cart
        >
          ADD TO CART
        </button>

        <p
          class="product-modal__message"
          data-cart-message
        ></p>
      </div>
    </div>
  </div>

</section>

<script src="{{ 'custom-product-grid.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
