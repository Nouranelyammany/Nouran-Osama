
{{'custom-banner.css' | asset_url | stylesheet_tag}}


<!-- main banner section -->
<section class="custom-banner">

<!-- header content: logo, message and yellow gift button -->
<header class="custom-banner__header">
<div class="custom-banner__logo">
{{section.settings.logo_text}}
</div>
<p class="custom-banner__message">
{{section.settings.header_message}}
</p>
<a
href="{{section.settings.top_button_link}}"
class="custom-banner__top-button"
>
{{section.settings.top_button_text}}
<span>→</span>
</a>
</header>
<!-- main content: text and background image -->
<div class="custom-banner__main">
<div class="custom-banner__content">
<h1>
{{section.settings.heading}}
</h1>
<p>
{{section.settings.description | newline_to_br}}
</p>
<a href="{{section.settings.main_button_link}}"
class="custom-banner__main-button"
>
{{ section.settings.main_button_text }}
<span>→</span>
</a>
</div>
  {% if section.settings.main_image != blank %}
   <img
   src="{{ section.settings.main_image | image_url: width: 2000 }}"
   alt="{{ section.settings.heading }}"
    class="custom-banner__image"
    >
      {% endif %}
        </div>
        <div class= "custom-banner__announcement">
        {{section.settings.announcement_text}}
        </div>
        </section>


      
<!-- Theme Customizer settings for editable banner content -->
{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "header_message",
      "label": "Header message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },
    {
        "type": "image_picker",
         "id": "main_image",
          "label": "Main image"
    },
    {
        "type": "text",
        "id": "heading",
         "label": "Heading",
         "default": "The Gift Guide"
    },
    {
        "type": "textarea",
        "id": "description",
         "label": "Description",
         "default": "Discover Joy: Your Ultimates Holiday Gift Destination.Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
        "type": "text",
         "id": "main_button_text",
         "label": "Main button text",
         "default": "SHOP NOW"
    },
    {
        "type": "url",
        "id": "main_button_link",
        "label": "Main button link"
    },
    {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement text",
        "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
    ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}